<?xml version="1.0" encoding="UTF-8"?>

<sdf version="1.9">

  <model name="x500_lidar_3d">


    <!-- ========================= -->
    <!-- X500无人机主体 -->
    <!-- ========================= -->

    <include merge="true">

      <uri>x500</uri>

    </include>


    <!-- ========================= -->
    <!-- 3D LiDAR -->
    <!-- 安装在机体上方 -->
    <!-- ========================= -->

    <include merge="true">

      <uri>model://lidar_3d</uri>

      <pose>0.12 0 0.26 0 0 0</pose>

    </include>


    <!-- ========================= -->
    <!-- 将LiDAR固定到无人机 -->
    <!-- ========================= -->

    <joint name="LidarJoint" type="fixed">

      <parent>base_link</parent>

      <child>link</child>

      <pose relative_to="base_link">
        -0.1 0 0.26 0 0 0
      </pose>

    </joint>


  </model>

</sdf>
